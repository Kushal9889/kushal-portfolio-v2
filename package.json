{
  "name": "kushalgaddamwar",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:index && npm run build:graph && npm run build:topology && npm run prewarm && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:index": "tsx scripts/build-index.ts",
    "verify:facts": "tsx scripts/verify-facts.ts",
    "verify:links": "tsx scripts/verify-links.ts",
    "lint:tokens": "tsx scripts/lint-tokens.ts",
    "test:evals": "tsx scripts/run-evals.ts",
    "check": "npm run typecheck && npm run lint:tokens && npm run lint:vars && npm run verify:facts && npm run audit",
    "test:silhouette": "tsx scripts/silhouette.ts",
    "prewarm": "tsx scripts/prewarm.ts",
    "decision-matrix": "tsx scripts/decision-matrix.ts",
    "audit": "tsx scripts/audit.ts",
    "build:graph": "tsx scripts/build-graph.ts",
    "test:unit": "tsx --test tests/unit.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:system": "npm run build && tsx --test --test-timeout=120000 tests/system.test.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:system",
    "build:topology": "tsx scripts/build-topology.ts",
    "build:readme": "tsx scripts/build-profile-readme.ts",
    "lint:vars": "tsx scripts/lint-vars.ts",
    "bench:retrieval": "tsx scripts/bench-retrieval.ts",
    "sync:vectors": "tsx scripts/sync-vectors.ts",
    "bench:models": "tsx scripts/bench-models.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "@neondatabase/serverless": "^1.1.0",
    "gsap": "^3.15.0",
    "kokoro-js": "^1.2.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
