{
  "name": "kushalgaddamwar",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:index && npm run build:field && npm run build:icons && npm run build:guilloche && npm run build:graph && npm run build:topology && npm run build:cache && npm run build:grain && npm run prewarm && next build",
    "build:cache": "tsx scripts/build-cache.ts",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:index": "tsx scripts/build-index.ts",
    "build:field": "tsx scripts/build-field.ts",
    "verify:facts": "tsx scripts/verify-facts.ts",
    "verify:links": "tsx scripts/verify-links.ts",
    "lint:tokens": "tsx scripts/lint-tokens.ts",
    "test:evals": "tsx scripts/run-evals.ts",
    "check": "npm run typecheck && npm run lint:tokens && npm run lint:vars && npm run verify:facts && npm run audit",
    "test:silhouette": "tsx scripts/silhouette.ts",
    "prewarm": "tsx scripts/prewarm.ts",
    "decision-matrix": "tsx scripts/decision-matrix.ts",
    "audit": "tsx scripts/audit.ts",
    "build:graph": "tsx scripts/build-graph.ts",
    "test:unit": "tsx --test tests/unit.test.ts tests/grammar.test.ts tests/film.test.ts tests/serving.test.ts tests/redact.test.ts tests/claims.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:system": "npm run build && tsx --test --test-timeout=120000 tests/system.test.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:system",
    "build:topology": "tsx scripts/build-topology.ts",
    "build:grain": "tsx scripts/build-grain.ts",
    "check:ramps": "tsx scripts/check-ramps.ts",
    "build:icons": "tsx scripts/build-icons.ts && tsx scripts/build-ui-icons.ts && tsx scripts/build-glyph-points.ts",
    "build:readme": "tsx scripts/build-profile-readme.ts",
    "lint:vars": "tsx scripts/lint-vars.ts",
    "bench:retrieval": "tsx scripts/bench-retrieval.ts",
    "sync:vectors": "tsx scripts/sync-vectors.ts",
    "bench:models": "tsx scripts/bench-models.ts",
    "build:guilloche": "tsx scripts/build-guilloche.ts",
    "bench:film": "python3 scripts/bench-film.py",
    "test:agent": "tsx scripts/agent-scenarios.ts --split test --gate",
    "test:agent:faults": "AGENT_FAULT=outage tsx scripts/agent-scenarios.ts --split test --gate && AGENT_FAULT=429 tsx scripts/agent-scenarios.ts --split test --gate && AGENT_FAULT=timeout tsx scripts/agent-scenarios.ts --split test --gate"
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@vercel/otel": "^2.1.3",
    "gsap": "^3.15.0",
    "kokoro-js": "^1.2.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource-variable/hubot-sans": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@phosphor-icons/core": "^2.1.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^22",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "culori": "^4.0.2",
    "devicon": "^2.17.0",
    "opentype.js": "^2.0.0",
    "simple-icons": "^16.33.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "wawoff2": "^2.0.1"
  }
}
